<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:jdbc="http://www.springframework.org/schema/jdbc"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/jdbc
           http://www.springframework.org/schema/jdbc/spring-jdbc.xsd
           http://www.springframework.org/schema/tx
           http://www.springframework.org/schema/tx/spring-tx.xsd">

  <!--
    Integration test data source.

    An embedded H2 database standing in for Oracle. There is no ORM to generate a schema, so
    the tables, sequences and views are created by running the DDL scripts below, one per
    object, followed by the seed data. That keeps the test schema readable as a schema rather
    than hidden inside annotations, and it means the same SQL the DAOs issue is exercised
    against a real database rather than a mock.

    Every statement the DAOs issue is written in the subset that both Oracle and H2 accept:
    DUAL, SYSTIMESTAMP, sequence NEXTVAL, ROWNUM, NVL and TRUNC all behave the same in both.
  -->
  <jdbc:embedded-database id="dataSource" type="H2">

    <!-- Tables -->
    <jdbc:script location="classpath:sql/tables/AMS_ADDRESSES.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_ASSETS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_ASSET_CONFIGS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_ASSET_RETURNS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_CONTACTS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_CUSTOMERS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_CUSTOMER_EARLY_ADOPTERS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_CUSTOMER_SCHEDULES.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_DECOMMISSIONS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_EMAIL_QUEUE.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_ETL_RUNS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_EVENTS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_HOLIDAYS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_INSTALLATIONS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_INSTALL_REGIONS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_LOADABLE_TYPES.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_MAINTENANCE_WINDOWS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_MODIFY_QUEUE.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_NCR_TYPES.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_NETWORK_CHANGE_REQUESTS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_ORDERS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_PORT_CONFIGS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_PROPERTIES.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_RMAS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_SAVE_FOR_LATER.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_SERVICES.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_SUBSCRIBER_PCS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_TERMS_ACCEPTANCES.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_TERMS_AND_CONDITIONS.sql"/>
    <jdbc:script location="classpath:sql/tables/AMS_TIMESLOTS.sql"/>

    <!-- Sequences -->
    <jdbc:script location="classpath:sql/sequences/AMS_ADDRESSES_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_ASSETS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_ASSET_CONFIGS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_ASSET_RETURNS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_CONTACTS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_DECOMMISSIONS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_EMAIL_QUEUE_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_EVENTS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_MODIFY_QUEUE_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_NCR_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_ORDERS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_RMAS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_SAVE_FOR_LATER_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_MAINT_WINDOWS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_SUBSCRIBER_PCS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_INSTALLATIONS_SQ.sql"/>
    <jdbc:script location="classpath:sql/sequences/AMS_TIMESLOTS_SQ.sql"/>

    <!-- Views -->
    <jdbc:script location="classpath:sql/views/AMS_NCR_SCHEDULES_EXT_V.sql"/>

    <!-- Seed data -->
    <jdbc:script location="classpath:sql/data/AMS_ADDRESSES.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_ASSETS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_ASSET_CONFIGS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_CONTACTS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_CUSTOMERS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_CUSTOMER_EARLY_ADOPTERS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_CUSTOMER_SCHEDULES.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_DECOMMISSIONS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_ETL_RUNS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_HOLIDAYS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_INSTALL_REGIONS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_LOADABLE_TYPES.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_MAINTENANCE_WINDOWS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_MODIFY_QUEUE.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_NCR_TYPES.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_NETWORK_CHANGE_REQUESTS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_ORDERS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_PORT_CONFIGS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_PROPERTIES.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_RMAS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_SERVICES.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_TERMS_AND_CONDITIONS.sql"/>
    <jdbc:script location="classpath:sql/data/AMS_TIMESLOTS.sql"/>
  </jdbc:embedded-database>

  <bean id="transactionManager"
        class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
    <property name="dataSource" ref="dataSource"/>
  </bean>

  <tx:annotation-driven transaction-manager="transactionManager"/>

</beans>
