target/
*.class
.DS_Store

# Supplied per environment, never committed.
# The Oracle driver is not redistributable under its licence; the CA certificate differs per
# environment and a local one is generated by hand. Each directory has a README explaining what
# belongs there.
ams-internal/AssetManagementInternalWeb/lib/*.jar
ams-internal/AssetManagementInternalWeb/certs/*.crt
ams-internal/AssetManagementInternalWeb/certs/*.pem

.env

# The Dojo toolkit release build: ~11,000 third-party files, ~72 MB, restored from the official
# archive rather than committed. js/dojo-release-1.17.3/README.txt has the command and checksum.
ams-internal/AssetManagementInternalWeb/src/main/webapp/js/dojo-release-1.17.3/dojo/
ams-internal/AssetManagementInternalWeb/src/main/webapp/js/dojo-release-1.17.3/dijit/
ams-internal/AssetManagementInternalWeb/src/main/webapp/js/dojo-release-1.17.3/dojox/
ams-internal/AssetManagementInternalWeb/src/main/webapp/js/dojo-release-1.17.3/build-report.txt
