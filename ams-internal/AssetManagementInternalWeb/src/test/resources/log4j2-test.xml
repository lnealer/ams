<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="CONSOLE" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} AMS-TEST %-5p [%c{1}] %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="org.example.am" level="info" additivity="false">
      <AppenderRef ref="CONSOLE"/>
    </Logger>
    <Logger name="ALERT_LOGGER" level="error" additivity="false">
      <AppenderRef ref="CONSOLE"/>
    </Logger>
    <Logger name="org.springframework" level="warn"/>
    <Root level="warn">
      <AppenderRef ref="CONSOLE"/>
    </Root>
  </Loggers>
</Configuration>
