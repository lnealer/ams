<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <!--
    Provisioning: what happens to an order after it is placed.

    Kept in its own namespace rather than folded into /order, because these are warehouse and field
    operations acting on a finished order, not further steps of the ordering flow. Nothing here
    touches the session-held OrderModel.
  -->
  <package name="provisioning" namespace="/provisioning" extends="AssetManagementInternalWeb">

    <action name="Despatch" class="ProvisioningAction" method="initDespatch">
      <result>/WEB-INF/provisioning/despatch.jsp</result>
      <result name="input">/WEB-INF/provisioning/despatch.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SubmitDespatch" class="ProvisioningAction" method="despatch">
      <result>/WEB-INF/provisioning/despatched.jsp</result>
      <result name="input">/WEB-INF/provisioning/despatch.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="CompleteInstallation" class="ProvisioningAction" method="initComplete">
      <result>/WEB-INF/provisioning/completeInstallation.jsp</result>
      <result name="input">/WEB-INF/provisioning/completeInstallation.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SubmitCompleteInstallation" class="ProvisioningAction" method="complete">
      <result>/WEB-INF/provisioning/completeInstallation.jsp</result>
      <result name="input">/WEB-INF/provisioning/completeInstallation.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>
  </package>
</struts>
