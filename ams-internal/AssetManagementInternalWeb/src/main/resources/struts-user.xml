<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <!--
    NON-PRODUCTION ONLY.

    These actions let a tester rebuild their own authentication with different directory groups and
    move the application's clock. UserAction refuses to do anything unless the environment is
    non-production, the ENABLEIMPERS property is on, and the caller holds INT_CHANGE_USER - but
    this file is the other half of that control. Removing this include removes the endpoints
    entirely, and nothing else refers to them.
  -->
  <package name="user" namespace="/user" extends="AssetManagementInternalWeb">

    <action name="ChangeUser" class="UserAction" method="changeUser">
      <result>/WEB-INF/user/changeUser.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SubmitChangeUser" class="UserAction" method="submitChangeUser">
      <result>/WEB-INF/user/changeUserConfirmation.jsp</result>
      <result name="input">/WEB-INF/user/changeUser.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="ClearTimeOverride" class="UserAction" method="clearTimeOverride">
      <result>/WEB-INF/user/changeUserConfirmation.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>
  </package>

</struts>
