<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <package name="assets" namespace="/assets" extends="AssetManagementInternalWeb">

    <action name="ViewAsset" class="AssetAction" method="viewAsset">
      <result>/WEB-INF/assets/assetDetail.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="InitDecommission" class="DecommissionAction" method="initDecommission">
      <result>/WEB-INF/assets/decommission.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SubmitDecommission" class="DecommissionAction" method="submitDecommission">
      <result>/WEB-INF/assets/decommissionConfirmation.jsp</result>
      <result name="input">/WEB-INF/assets/decommission.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="CancelDecommission" class="DecommissionAction" method="cancelDecommission">
      <result>/WEB-INF/assets/decommissionConfirmation.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="CompareConfig" class="CompareConfigAction" method="compareConfig">
      <result>/WEB-INF/assets/compareConfig.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="AcceptDeviceConfig"
            class="ResolveConfigurationMismatchAction" method="acceptDevice">
      <result>/WEB-INF/assets/resolveConfigurationMismatch.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="ReapplyStoredConfig"
            class="ResolveConfigurationMismatchAction" method="reapplyStored">
      <result>/WEB-INF/assets/resolveConfigurationMismatch.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="InitUpdateInstallAddress"
            class="UpdateInstallAddressAction" method="initUpdateInstallAddress">
      <result>/WEB-INF/assets/updateInstallAddress.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="SubmitUpdateInstallAddress"
            class="UpdateInstallAddressAction" method="submitUpdateInstallAddress">
      <result>/WEB-INF/assets/updateInstallAddressConfirmation.jsp</result>
      <result name="input">/WEB-INF/assets/updateInstallAddress.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>
  </package>

</struts>
