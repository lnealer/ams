<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <package name="networkChangeRequest" namespace="/networkChangeRequest"
           extends="AssetManagementInternalWeb">

    <action name="InitRequest" class="NetworkChangeRequestAction" method="initRequest">
      <result>/WEB-INF/global/networkChangeRequest.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SubmitRequest" class="NetworkChangeRequestAction" method="submitRequest">
      <result>/WEB-INF/global/networkChangeRequestConfirmation.jsp</result>
      <result name="input">/WEB-INF/global/networkChangeRequest.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="ViewRequest" class="NetworkChangeRequestDetailsAction" method="viewRequest">
      <result>/WEB-INF/global/networkChangeRequestDetails.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="CancelRequest" class="NetworkChangeRequestDetailsAction" method="cancelRequest">
      <result>/WEB-INF/global/networkChangeRequestDetails.jsp</result>
      <result name="input">/WEB-INF/global/networkChangeRequestDetails.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="ViewHistory" class="NetworkChangeRequestHistoryAction" method="viewHistory">
      <result>/WEB-INF/global/networkChangeRequestHistory.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="InitReschedule" class="RescheduleNcrAction" method="initReschedule">
      <result>/WEB-INF/global/rescheduleNcr.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="SubmitReschedule" class="RescheduleNcrAction" method="submitReschedule">
      <result>/WEB-INF/global/networkChangeRequestConfirmation.jsp</result>
      <result name="input">/WEB-INF/global/rescheduleNcr.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>
  </package>

</struts>
