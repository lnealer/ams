<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>

  <!-- The pickers fetch their slots as the user moves through the calendar, so all JSON. -->
  <package name="calendar" namespace="/calendar" extends="AssetManagementInternalWeb">

    <default-interceptor-ref name="assetManagementJsonStack"/>

    <action name="TechLineTimeSlots" class="CalendarAction" method="techLineTimeSlots">
      <result type="json"/>
      <result name="unauthorized" type="json"/>
    </action>

    <action name="InstallationTimeSlots" class="CalendarAction" method="installationTimeSlots">
      <result type="json"/>
      <result name="unauthorized" type="json"/>
    </action>

    <action name="InstallationTimeSlotsModifiedForDashboardTechline"
            class="CalendarAction" method="installationTimeSlotsModifiedForDashboardTechline">
      <result type="json"/>
      <result name="unauthorized" type="json"/>
    </action>

    <action name="ServiceTimeSlots" class="CalendarAction" method="serviceTimeSlots">
      <result type="json"/>
      <result name="unauthorized" type="json"/>
    </action>

    <action name="BookTechline" class="TechLineAction" method="bookTechline">
      <result type="json"/>
      <result name="input" type="json"/>
    </action>

    <action name="BookInstallation" class="InstallationAction" method="bookInstallation">
      <result type="json"/>
      <result name="input" type="json"/>
    </action>

    <action name="CancelInstallation" class="InstallationAction" method="cancelInstallation">
      <result type="json"/>
      <result name="error" type="json"/>
    </action>
  </package>

</struts>
