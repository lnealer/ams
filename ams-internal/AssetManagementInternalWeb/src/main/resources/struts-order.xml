<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>

  <!--
    The ordering flow, in seven steps:

      0  InitOrder            order type (and, for a replacement, the asset it replaces)
      1  BeginOrder           contact information
      2  OrderAddress         shipping and installation address, validated against the API
      3  OrderDevice          device nickname and maintenance window
      4  OrderConfiguration   external configuration: WAN and LAN
      5  OrderSubscriberPcs   the machines that will sit behind the device
      6  ShippingWindow       the despatch window, then Place order

    There is deliberately no review step. Each step validates its own input and the place step
    re-validates the lot, so a review page would only be a read-only repeat of what the user has
    just been through.

    The partly completed order lives in the session between steps, so nothing is written until it
    is placed and an abandoned order leaves no rows behind.
  -->
  <package name="order" namespace="/order" extends="AssetManagementInternalWeb">

    <action name="InitOrder" class="OrderNewAction" method="initOrder">
      <result>/WEB-INF/order/orderNew.jsp</result>
      <result name="input">/WEB-INF/order/orderNew.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!--
      Records the order type. Separate from InitOrder, which only renders the page: BeginOrder is
      the contact step now, so without this the type chosen on the first screen reached nothing
      and every order was placed with a null order type.
    -->
    <action name="SelectOrderType" class="OrderNewAction" method="selectOrderType">
      <result type="redirectAction">
        <param name="actionName">BeginOrder</param>
      </result>
      <result name="selectAsset" type="redirectAction">
        <param name="actionName">SelectAsset</param>
      </result>
      <result name="input">/WEB-INF/order/orderNew.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SelectAsset" class="OrderSelectAssetAction" method="selectAsset">
      <result>/WEB-INF/order/selectAsset.jsp</result>
      <result name="input">/WEB-INF/order/selectAsset.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SelectEmergencyReplacementAsset"
            class="OrderSelectAssetAction" method="selectEmergencyReplacementAsset">
      <result>/WEB-INF/order/selectAsset.jsp</result>
      <result name="input">/WEB-INF/order/selectAsset.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- Step 1: contacts. Keeps the BeginOrder name the rest of the application links to. -->
    <action name="BeginOrder" class="OrderContactAction" method="initContacts">
      <result>/WEB-INF/order/orderContact.jsp</result>
      <result name="input">/WEB-INF/order/orderContact.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SaveContacts" class="OrderContactAction" method="saveContacts">
      <result type="redirectAction">
        <param name="actionName">OrderAddress</param>
      </result>
      <result name="input">/WEB-INF/order/orderContact.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- Step 2: the address. -->
    <action name="OrderAddress" class="OrderAddressAction" method="initAddress">
      <result>/WEB-INF/order/orderAddress.jsp</result>
      <result name="input">/WEB-INF/order/orderAddress.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!--
      Wrapped by the address validation interceptor. The three av.* results are what it returns:
      the address was accepted as keyed, the service has a correction to confirm, or the check
      could not be made. Only the first moves the user on - the other two ask a question first.

      A validation outage is av.error and the flow continues from that page, because an address
      service being down must not stop an order being placed.
    -->
    <action name="SaveAddress" class="OrderAddressAction" method="saveAddress">
      <interceptor-ref name="addressValidationStack"/>
      <result type="redirectAction">
        <param name="actionName">OrderDevice</param>
      </result>
      <result name="av.success" type="redirectAction">
        <param name="actionName">OrderDevice</param>
      </result>
      <result name="av.suggestion">/WEB-INF/order/orderAddressSuggestion.jsp</result>
      <result name="av.error">/WEB-INF/order/orderAddressUnverified.jsp</result>
      <result name="input">/WEB-INF/order/orderAddress.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="AcceptAddressSuggestion" class="OrderAddressAction" method="acceptSuggestion">
      <result type="redirectAction">
        <param name="actionName">OrderDevice</param>
      </result>
      <result name="input">/WEB-INF/order/orderAddressSuggestion.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="KeepAddressAsKeyed" class="OrderAddressAction" method="keepAddressAsKeyed">
      <result type="redirectAction">
        <param name="actionName">OrderDevice</param>
      </result>
      <result name="input">/WEB-INF/order/orderAddress.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- Step 3: nickname and maintenance window. -->
    <action name="OrderDevice" class="OrderDeviceAction" method="initDevice">
      <result>/WEB-INF/order/orderDevice.jsp</result>
      <result name="input">/WEB-INF/order/orderDevice.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SaveDevice" class="OrderDeviceAction" method="saveDevice">
      <result type="redirectAction">
        <param name="actionName">OrderConfiguration</param>
      </result>
      <result name="input">/WEB-INF/order/orderDevice.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- Step 4: WAN and LAN. -->
    <action name="OrderConfiguration" class="OrderConfigurationAction" method="initConfiguration">
      <result>/WEB-INF/order/orderConfiguration.jsp</result>
      <result name="input">/WEB-INF/order/orderConfiguration.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SaveConfiguration" class="OrderConfigurationAction" method="saveConfiguration">
      <result type="redirectAction">
        <param name="actionName">OrderSubscriberPcs</param>
      </result>
      <result name="input">/WEB-INF/order/orderConfiguration.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- Step 5: subscriber machines. -->
    <action name="OrderSubscriberPcs" class="OrderSubscriberPcAction" method="initSubscriberPcs">
      <result>/WEB-INF/order/orderSubscriberPcs.jsp</result>
      <result name="input">/WEB-INF/order/orderSubscriberPcs.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="AddSubscriberPcRows" class="OrderSubscriberPcAction" method="addSubscriberPcRows">
      <result>/WEB-INF/order/orderSubscriberPcs.jsp</result>
      <result name="input">/WEB-INF/order/orderSubscriberPcs.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SaveSubscriberPcs" class="OrderSubscriberPcAction" method="saveSubscriberPcs">
      <result type="redirectAction">
        <param name="actionName">ShippingWindow</param>
      </result>
      <result name="input">/WEB-INF/order/orderSubscriberPcs.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- Step 6: the despatch window, and the button that places the order. -->
    <action name="ShippingWindow" class="OrderShippingWindowAction" method="initShippingWindow">
      <result>/WEB-INF/order/orderShippingWindow.jsp</result>
      <result name="input">/WEB-INF/order/orderShippingWindow.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!--
      Chained to PlaceOrder rather than redirected to it, and the difference matters. A redirect
      would turn placing an order into a GET: it would bypass the CSRF check, which only guards
      non-safe methods, and a browser refresh on the resulting URL would raise a second order.
      Chaining keeps the whole thing inside the one POST the user submitted.
    -->
    <action name="SaveShippingWindow" class="OrderShippingWindowAction" method="saveShippingWindow">
      <result type="chain">PlaceOrder</result>
      <result name="input">/WEB-INF/order/orderShippingWindow.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SkipShippingWindow" class="OrderShippingWindowAction" method="skipShippingWindow">
      <result type="chain">PlaceOrder</result>
      <result name="input">/WEB-INF/order/orderShippingWindow.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!--
      Places the order. On failure it renders the despatch window page, which is the step the user
      pressed the button on and therefore the one they expect to be looking at.
    -->
    <action name="PlaceOrder" class="OrderSubmitAction" method="submitOrder">
      <result type="redirectAction">
        <param name="actionName">OrderConfirmation</param>
        <param name="orderId">${submittedOrderId}</param>
        <param name="shippingWindowLost">${shippingWindowLost}</param>
      </result>
      <result name="input">/WEB-INF/order/orderShippingWindow.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SaveForLater" class="OrderSaveForLaterAction" method="saveForLater">
      <result>/WEB-INF/order/savedOrder.jsp</result>
      <result name="input">/WEB-INF/order/orderContact.jsp</result>
    </action>

    <action name="ContinueOrder" class="OrderSaveForLaterAction" method="continueOrder">
      <result type="redirectAction">
        <param name="actionName">BeginOrder</param>
      </result>
      <result name="input">/WEB-INF/order/savedOrder.jsp</result>
    </action>

    <action name="OrderConfirmation" class="OrderConfirmationAction" method="confirmation">
      <result>/WEB-INF/order/orderConfirmation.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="AbandonOrder" class="OrderCancelAction" method="abandonOrder">
      <result type="redirectAction">
        <param name="actionName">InitOrder</param>
      </result>
    </action>

    <!-- The configuration form's data endpoint. -->
    <action name="GetLegacyAssetConfig" class="OrderAction" method="getLegacyAssetConfig">
      <interceptor-ref name="assetManagementJsonStack"/>
      <result type="json"/>
      <result name="error" type="json"/>
    </action>

    <action name="ModifyConfiguration" class="OrderAction" method="modifyConfiguration">
      <result>/WEB-INF/order/modifyConfiguration.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="MoveAsset" class="OrderAction" method="moveAsset">
      <result>/WEB-INF/order/moveAsset.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>
  </package>

</struts>
