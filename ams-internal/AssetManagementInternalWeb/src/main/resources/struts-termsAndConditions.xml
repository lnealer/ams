<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <package name="termsAndConditions" namespace="/termsAndConditions"
           extends="AssetManagementInternalWeb">

    <action name="ViewTerms" class="TermsAndConditionsAction" method="viewTerms">
      <result>/WEB-INF/common/termsAndConditions.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="AcceptTerms" class="TermsAndConditionsAction" method="acceptTerms">
      <result>/WEB-INF/common/termsAndConditions.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>
  </package>

</struts>
