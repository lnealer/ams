<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <package name="admin" namespace="/admin" extends="AssetManagementInternalWeb">

    <action name="InitAdminUtilities" class="AdminUtilitiesAction" method="initAdminUtilities">
      <result>/WEB-INF/admin/adminUtilities.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="Queues" class="AdminUtilitiesAction" method="initAdminUtilities">
      <interceptor-ref name="AdminUtilJsonStack"/>
      <result type="json">
        <param name="root">queueDepths</param>
      </result>
      <result name="unauthorized" type="json"/>
    </action>
  </package>

</struts>
