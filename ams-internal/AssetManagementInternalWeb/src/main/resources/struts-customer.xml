<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <package name="customer" namespace="/customer" extends="AssetManagementInternalWeb">

    <!--
      The picker. Reached from the navigation and from the header on every page, because nearly
      every other screen refuses to act until a customer has been chosen.
    -->
    <action name="CustomerPicker" class="SearchAction" method="initCustomerPicker">
      <result>/WEB-INF/customer/selectCustomer.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="ClearCustomer" class="SearchAction" method="clearCustomer">
      <result>/WEB-INF/customer/selectCustomer.jsp</result>
    </action>

    <action name="CustomerAdmin" class="CustomerAdminAction" method="initCustomerAdmin">
      <result>/WEB-INF/customer/customerAdmin.jsp</result>
      <result name="input">/WEB-INF/customer/customerAdmin.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- Answers JSON: the switch is flipped in place rather than through a form submit. -->
    <action name="UpdateCanSubmitOrders" class="CustomerAdminAction" method="updateCanSubmitOrders">
      <interceptor-ref name="assetManagementJsonStack"/>
      <result type="json"/>
      <result name="error" type="json"/>
      <result name="unauthorized" type="json"/>
    </action>

    <action name="ShowEnableOrdering" class="CustomerAdminAction" method="showEnableOrdering">
      <result>/WEB-INF/customer/enableOrdering.jsp</result>
      <result name="input">/WEB-INF/customer/enableOrdering.jsp</result>
    </action>

    <action name="AssetInstallations" class="AssetInstallationsAction" method="getInstallations">
      <interceptor-ref name="assetManagementJsonStack"/>
      <result type="json">
        <param name="root">assets</param>
      </result>
    </action>

    <action name="Contacts" class="AmsServicesAction" method="listServices">
      <result>/WEB-INF/contacts/contacts.jsp</result>
      <result name="input">/WEB-INF/contacts/contacts.jsp</result>
    </action>
  </package>

</struts>
