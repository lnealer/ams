<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <package name="cancel" namespace="/cancel" extends="AssetManagementInternalWeb">

    <action name="CancelOrder" class="CancelAction" method="cancelOrder">
      <result>/WEB-INF/cancel/cancelOrder.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SubmitCancelOrder" class="CancelAction" method="submitCancelOrder">
      <result>/WEB-INF/cancel/cancelOrderConfirmation.jsp</result>
      <result name="input">/WEB-INF/cancel/cancelOrder.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="CancelModifyConfiguration"
            class="CancelAction" method="cancelModifyConfiguration">
      <result>/WEB-INF/cancel/cancelModifyConfiguration.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="SubmitCancelModifyConfiguration"
            class="CancelAction" method="submitCancelModifyConfiguration">
      <result>/WEB-INF/cancel/cancelOrderConfirmation.jsp</result>
      <result name="error">/WEB-INF/global/customError.jsp</result>
    </action>
  </package>

</struts>
