<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <!--
    Everything here answers JSON and runs the token-checking stack, so a request that did not come
    from a page this application served is refused before it reaches an action.
  -->
  <package name="ajax" namespace="/ajax" extends="AssetManagementInternalWeb">

    <default-interceptor-ref name="assetManagementJsonStack"/>

    <action name="ClearAttentionFlag" class="AjaxAssetAttentionAction" method="clearAttentionFlag">
      <result type="json"/>
      <result name="error" type="json"/>
    </action>

    <action name="ToggleEmergencyReplacement"
            class="AjaxEnableEmergencyReplacementAction" method="toggle">
      <result type="json"/>
      <result name="error" type="json"/>
    </action>

    <action name="IsEmergencyReplacementEnabled"
            class="AjaxEnableEmergencyReplacementAction" method="isEnabledForAsset">
      <result type="json"/>
      <result name="error" type="json"/>
    </action>

    <action name="GetEvents" class="AjaxEventAction" method="listEvents">
      <result type="json">
        <param name="root">events</param>
      </result>
    </action>

    <action name="GetInstallationSlots" class="AjaxInstallationAction" method="getInstallationSlots">
      <result type="json"/>
    </action>

    <action name="GetTechlineSlots" class="AjaxTechlineAction" method="getTechlineSlots">
      <result type="json"/>
    </action>

    <action name="ListSavedOrders" class="AjaxSavedOrderAction" method="listSavedOrders">
      <result type="json"/>
    </action>

    <action name="DiscardSavedOrder" class="AjaxSavedOrderAction" method="discardSavedOrder">
      <result type="json"/>
      <result name="error" type="json"/>
    </action>

    <action name="ListSavedRequests" class="AjaxSavedNCRAction" method="listSavedRequests">
      <result type="json"/>
    </action>

    <action name="DiscardSavedRequest" class="AjaxSavedNCRAction" method="discardSavedRequest">
      <result type="json"/>
      <result name="error" type="json"/>
    </action>
  </package>

</struts>
