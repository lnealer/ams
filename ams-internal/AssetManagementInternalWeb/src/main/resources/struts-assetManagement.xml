<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>

  <package name="assetManagement" namespace="/assetManagement" extends="AssetManagementInternalWeb">

    <action name="InitSearch" class="SearchAction" method="initSearch">
      <result>/WEB-INF/assetManagement/search.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="Search" class="SearchAction" method="search">
      <result>/WEB-INF/assetManagement/searchResults.jsp</result>
      <result name="input">/WEB-INF/assetManagement/search.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="SelectCustomer" class="SearchAction" method="selectCustomer">
      <result>/WEB-INF/assetManagement/search.jsp</result>
      <result name="input">/WEB-INF/customer/selectCustomer.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- The customer picker's type-ahead; JSON, so it carries the AJAX token. -->
    <action name="GetCustomers" class="SearchAction" method="getCustomers">
      <interceptor-ref name="assetManagementJsonStack"/>
      <result type="json">
        <param name="root">customerList</param>
      </result>
    </action>

    <action name="InitDashboard" class="DashboardAction" method="initDashboard">
      <result>/WEB-INF/assetManagement/dashboard.jsp</result>
      <result name="unauthorized">/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <action name="GetDashboardLayout" class="DashboardAction" method="getDashboardLayout">
      <interceptor-ref name="assetManagementJsonStack"/>
      <result type="json">
        <param name="root">layout</param>
      </result>
    </action>

    <action name="AttentionQueue" class="AjaxAssetAttentionAction" method="getAttentionQueue">
      <interceptor-ref name="assetManagementJsonStack"/>
      <result type="json">
        <param name="root">assets</param>
      </result>
    </action>
  </package>

</struts>
